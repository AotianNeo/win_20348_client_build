    </update>
    <update description="命名管道激活" displayName="命名管道激活" name="WCF-Pipe-Activation45">
      <mum2:customInformation xmlns:mum2="urn:schemas-microsoft-com:asm.v3">
        <ServerComponent Description="命名管道激活支持通过命名管道激活进程。使用命名管道激活的应用程序可以动态地开始和停止响应网络上通过命名管道到达的工作项。" DisplayName="命名管道激活" Id="423" InstallWithParentByDefault="true" Parent="NET-WCF-Services45" Type="Feature" UniqueName="NET-WCF-Pipe-Activation45">

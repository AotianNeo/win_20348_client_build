    <update description="TCP 端口共享" displayName="TCP 端口共享" name="WCF-TCP-PortSharing45">
      <mum2:customInformation xmlns:mum2="urn:schemas-microsoft-com:asm.v3">
        <ServerComponent Description="利用 TCP 端口共享，多个 net.tcp 应用程序可共享一个 TCP 端口。因而，这些应用程序可在同一台物理计算机上在分开而独立的进程中共存，而同时共享通过 808 端口这样的 TCP 端口收发通信所需的网络基础结构。" DisplayName="TCP 端口共享" Id="425" InstallWithParentByDefault="true" Parent="NET-WCF-Services45" Type="Feature" UniqueName="NET-WCF-TCP-PortSharing45">
          <Deploys>
            <Update Name="WCF-TCP-PortSharing45" />
          </Deploys>
          <Version Major="4" Minor="5" />
        </ServerComponent>
      </mum2:customInformation>
      <applicable disposition="detect">
        <detectUpdate>
          <update name="WCF-Services45" />
        </detectUpdate>
      </applicable>
    </update>

    <update description="消息队列(MSMQ)激活" displayName="消息队列(MSMQ)激活" name="WCF-MSMQ-Activation45">
      <mum2:customInformation xmlns:mum2="urn:schemas-microsoft-com:asm.v3">
        <ServerComponent Description="消除队列激活支持通过消息队列激活进程。使用消息队列激活的应用程序可以动态地开始和停止响应网络上通过消息队列到达的工作项。" DisplayName="消息队列(MSMQ)激活" Id="422" InstallWithParentByDefault="true" Parent="NET-WCF-Services45" Type="Feature" UniqueName="NET-WCF-MSMQ-Activation45">

    <update description="提供启动卷和数据卷的整卷磁盘加密。" displayName="BitLocker 驱动器加密" name="BitLocker">
      <mum2:customInformation xmlns:mum2="urn:schemas-microsoft-com:asm.v3">
        <mum2:Version Major="8" Minor="0" />
        <ServerComponent Description="BitLocker 驱动器加密通过加密整个卷并检查早期启动组件的完整性，来帮助保护丢失、被盗或者被不当取消配置的计算机上的数据。只有成功验证这些组件并在原始计算机上找到加密的驱动器才能解密数据。完整性检查需要与之兼容的受信任的平台模块(TPM)。" DisplayName="BitLocker 驱动器加密" Id="61" Type="Feature" UniqueName="BitLocker">
          <NonAncestorDependencies>
            <ServerComponent UniqueName="EnhancedStorage" />
          </NonAncestorDependencies>
          <Deploys>
            <Update Name="BitLocker" />
          </Deploys>
        </ServerComponent>
      </mum2:customInformation>
